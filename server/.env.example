# Copy this file to .env and fill in real values. NEVER commit .env
NODE_ENV=development
PORT=5000

# Local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/azesolution_auth

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=c06760ca07bf5c3e27764b853f6f2c89a01f264996919dfef248870396872d0bb25e334d1346e135f52ebedc4331d9bc

# Frontend origin allowed by CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Cookie settings. For deployed frontend+backend on DIFFERENT domains use COOKIE_SAMESITE=none (requires HTTPS / NODE_ENV=production)
COOKIE_SAMESITE=lax

# Set to 1 when deployed behind a proxy (Render, Railway, Heroku, Nginx) so rate limiting sees real client IPs
TRUST_PROXY=0
